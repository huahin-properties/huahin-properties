rules_version = '2';

// huahin.properties — Firebase Storage Security Rules
//
// PHASE 1A.1 (Sept 2026) — security hardening ahead of case attachments.
//
// CORRECTION to the previous pass: Storage Rules CAN read Firestore via
// firestore.get() / firestore.exists(). The earlier version wrongly assumed
// they could not, and therefore fell back to a hardcoded Owner UID for every
// private path. Team membership is now read from the SAME source of truth
// Firestore uses — adminUsers/{uid} — so no second role database exists.
//
// What this file enforces:
//   • Public read ONLY on the three paths the public site actually renders.
//     Everything else, including any folder added in future, is private by
//     default (the old `allow read: if true` catch-all is gone).
//   • Anonymous owner-submission photos may be CREATED but never replaced,
//     and must be genuine images under a size cap — the public rule can no
//     longer be used to park PDFs, scripts or huge binaries in the bucket.
//   • A lister can only write their OWN profile photos.
//   • caseAttachments/ is private and Owner/Staff-only from day one.
//
// Firestore reads performed here (each counts toward Firestore quota):
//   exists(/databases/(default)/documents/adminUsers/{uid})   — team check
//   get(...adminUsers/{uid}).data.role                        — owner check
// Both run only on non-public paths, so ordinary public page views trigger
// no Firestore reads at all.
service firebase.storage {
  match /b/{bucket}/o {

    // ── identity helpers ─────────────────────────────────────────────────
    // Same model as firestore.rules: the original hardcoded UID is always
    // Owner, and anyone with an adminUsers document is a team member.

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeamMember() {
      return request.auth != null && (
        request.auth.uid == "n7TZKSBscPXE1kRU8WzYpsqJh2g2" ||
        firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function isOwner() {
      return request.auth != null && (
        request.auth.uid == "n7TZKSBscPXE1kRU8WzYpsqJh2g2" ||
        (firestore.exists(/databases/(default)/documents/adminUsers/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/adminUsers/$(request.auth.uid)).data.role == "owner")
      );
    }

    // True only when nothing exists at this path yet — the difference between
    // "add a new photo" and "replace someone else's".
    function isCreate() {
      return resource == null;
    }

    // Owner Submission resizes every photo to WebP before upload, so a
    // legitimate anonymous upload is always a modest image. Anything else
    // arriving on that public rule is abuse.
    // PHASE 1A.2 FIX (Sept 2026): contentType must be treated as OPTIONAL.
    // A Blob built in the browser does not always arrive with a contentType
    // on the Storage request, and `null.matches(...)` does not evaluate to
    // false in Rules — it makes the whole condition error out, which Firebase
    // reports to the client as a permission denial. That is what broke the
    // signed-out Owner Submission upload. The size cap and the create-only
    // constraint still do the real protective work; the type check now only
    // applies when a type is actually present.
    function isSafeImage(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && (
          !('contentType' in request.resource)
          || request.resource.contentType == null
          || request.resource.contentType.matches('image/.*')
        );
    }

    // ── PUBLIC WEBSITE ASSETS ────────────────────────────────────────────
    // Read by signed-out visitors on Home, Search, Property Details, Agent
    // Profile and the SEO landing pages. Public read is required here;
    // without it the live site shows broken images.

    match /propertyPhotos/{fileName} {
      allow read: if true;

      // LISTING-E2E-01 — who may write PUBLIC listing photos from a browser:
      //   * team members, and
      //   * a signed-in, NON-anonymous member who has a listers/{uid} record.
      // Anonymous sign-in (every chat visitor has one) can no longer create, replace or delete a
      // listing's photos, and the anonymous "own-*.webp" create path is gone: photos of a submitted
      // Case go to caseUploads/{uid}/... (private) and are copied here by the server at publish time
      // (Admin SDK) and removed again when the listing is taken down.
      // Still open (documented): a member can overwrite ANOTHER member's photo, because ownership
      // cannot be derived from the "<propertyId>-<index>.webp" file name (see the note below).
      //
      // Ownership cannot be checked from the filename: the pattern is "<propertyId>-<index>.webp" and a
      // propertyId itself contains hyphens, so the two cannot be separated without capture groups,
      // which Storage Rules do not support. The safe fix is a future path shape
      // (propertyPhotos/{propertyId}/{photoId}) — NOT a guess-parse today.
      function isMemberWriter() {
        return isTeamMember() || (request.auth != null && request.auth.token.firebase.sign_in_provider != "anonymous"
          && firestore.exists(/databases/(default)/documents/listers/$(request.auth.uid)));
      }
      allow create, update, delete: if isMemberWriter();
    }

    // ── CASE UPLOADS (private) — LISTING-E2E-01 ──────────────────────────────
    // A submitter (any signed-in user, anonymous sign-in included) may CREATE images in THEIR OWN
    // folder only: caseUploads/<their uid>/<submission key>/<n>.webp (or doc.webp). Create-only, image
    // only, size-capped, no replace, no delete. Readable by that uid and the team — nobody else.
    // The submitListingCase function verifies and copies them to casePhotos/ (team-only).
    match /caseUploads/{uid}/{key}/{fileName} {
      allow create: if request.auth != null && request.auth.uid == uid && isCreate()
        && key.matches('[A-Za-z0-9_-]{16,64}')
        && fileName.matches('([0-9]{1,2}|doc)\\.webp')
        && isSafeImage(8 * 1024 * 1024);
      allow read: if request.auth != null && (request.auth.uid == uid || isTeamMember());
      allow update, delete: if false;
    }
    // Private per-case photo copies (pending review). Team read only, written by the server only. These files have NO download
    // token (the server removes the one the browser upload minted), so Storage rules are the only way in.
    match /casePhotos/{caseId}/{allPaths=**} {
      allow read: if isTeamMember();
      allow write: if false;
    }
    // PUBLISHED copies of a Case's photos: public read, written and deleted by the server only (Admin SDK). A member's browser
    // can not create, overwrite or delete them, so one member can not tamper with another's published photos in this flow.
    match /publishedCasePhotos/{caseId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /profilePhotos/{fileName} {
      allow read: if true;

      // Slot ids are "lister-avatar-<uid>" / "lister-cover-<uid>", so the
      // owner IS derivable here — a lister may write only their own two
      // files, not another lister's.
      allow write: if isSignedIn() && (
        fileName == 'lister-avatar-' + request.auth.uid + '.webp' ||
        fileName == 'lister-cover-' + request.auth.uid + '.webp'
      );

      // Team members manage any profile slot (support / cleanup).
      allow write: if isTeamMember();
    }

    // Site-wide images (banners, area cards) rendered on public pages.
    // Written from Site Content, which Staff operate as well as the Owner.
    match /siteContent/{fileName} {
      allow read: if true;
      allow write: if isTeamMember();
    }

    // ── PRIVATE / INTERNAL ASSETS ────────────────────────────────────────
    // Reserved for Case Messenger attachments. Nothing writes here yet; the
    // path is declared now so it can never fall through to a permissive rule
    // later. Title deeds and identity documents will live here, so it is
    // private from the first day it exists.
    //
    // Owner AND Staff reach these directly through the Storage SDK — no
    // Cloud Function is needed for team access. Customers are different:
    // they are unauthenticated and hold only a trackToken, which must never
    // appear in a Storage path or in object metadata, so their upload and
    // download still go through the planned Cloud Function.
    match /caseAttachments/{propertyId}/{allPaths=**} {
      allow read, write: if isTeamMember();
    }

    // ── DEFAULT DENY ─────────────────────────────────────────────────────
    // Anything not named above is private. This replaces the old
    // `allow read: if true` catch-all: a new folder created in future is now
    // secret by default instead of public by default.
    // LISTING-E2E-01: this used to grant team members read/write on EVERY path (Storage ORs matching rules, so it overrode the
    // narrower rules above, e.g. casePhotos "write: false"). Team access is now granted only on the explicit paths above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
