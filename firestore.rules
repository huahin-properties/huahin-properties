rules_version = '2';

// huahin.properties — Firestore Security Rules
//
// Replaces the temporary wide-open rules (which expire 2026-08-08). Locked
// down now that real Firebase Authentication is in place for the admin
// account. Public visitors can read the data the site needs to render but
// cannot write anything directly — all writes go through the signed-in
// admin, exactly like before.
//
// ADMIN_UID below is the single admin account's Firebase Auth User UID
// (Firebase Console → Authentication → Users). If a second Staff account
// is added later (see BLUEPRINT.md §1 Owner/Staff roles), extend the
// isAdmin() function to check a list of UIDs or a Firestore-stored role
// instead of one hardcoded value.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == "n7TZKSBscPXE1kRU8WzYpsqJh2g2" ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    // Owner-only: financial/settings collections (Site Content, external
    // service costs, team management) — Staff can use the rest of the admin
    // tools but not these. The original hardcoded UID is always Owner.
    function isOwner() {
      return request.auth != null && (
        request.auth.uid == "n7TZKSBscPXE1kRU8WzYpsqJh2g2" ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == "owner")
      );
    }

    // Public, read-only data the site renders for every visitor.
    // Public read. Admin can write anything. A signed-in lister may create/
    // edit/delete ONLY their own property (listerId must match their own
    // Auth UID both before and after the write) — self-serve listing (see
    // BLUEPRINT.md "Lister Dashboard").
    match /properties/{id} {
      allow read: if true;
      // Listing lifecycle v2 (trial/expiry/approval — BLUEPRINT.md §2 ทาง 2
      // rewritten กรกฎาคม 2026): a lister may create/edit their own listing
      // freely EXCEPT they can never write listingStatus == "live" directly
      // — that transition is admin-only (approveListing Cloud-side call),
      // UNLESS the listing is already "expired" AND they currently hold an
      // ACTIVE PAID package (self-renew without re-approval — trial does
      // NOT count, per the P1 fix "Membership Renewal Logic": a free trial
      // must never grant free-forever renewal). Enforced HERE at the rules
      // level (not just hidden in the UI) so it can't be bypassed by
      // calling firebase-client.js's renewListing() directly from the
      // browser console/devtools or any other client — Firestore itself
      // refuses the write regardless of what code asked for it.
      function listerHasActivePaidPackage() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/listers/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/listers/$(request.auth.uid)).data.subscriptionStatus == "active" &&
          get(/databases/$(database)/documents/listers/$(request.auth.uid)).data.tier in ["pro", "agency", "level3", "level4"];
      }
      // Aug 2026: auto-publish — a lister may now set their own listing
      // straight to "live" (previously admin-only). The one thing they can
      // NEVER do is move it OUT of "offline" — that status only exists
      // because an admin put it there (see setPropertyOffline in
      // firebase-client.js), and only an admin write (isAdmin() above) can
      // undo it. This is enforced here, not just in the UI, so it can't be
      // bypassed from devtools/console.
      function listerListingStatusOk() {
        return request.resource.data.listingStatus == resource.data.listingStatus
          || (request.resource.data.listingStatus == "live" && resource.data.listingStatus != "offline")
          || (request.resource.data.listingStatus == "paused" && resource.data.listingStatus != "offline");
      }
      // Staff role (Aug 2026, Owner-approval workflow): a Staff member may
      // prepare a listing (create/edit/upload photos, draft it, mark it
      // "pending_owner") but may NEVER put it live — only the Owner can flip
      // listingStatus to "live". Enforced here, not just in the UI, so it
      // cannot be bypassed from devtools/console.
      function isStaffOnly() {
        return isAdmin() && !isOwner();
      }
      function staffStatusOk() {
        return request.resource.data.listingStatus != "live";
      }
      // Public owner-submission channel (Owner Submission.dc.html): a visitor
      // with no account may create a listing ONLY as an unpublished pending
      // submission carrying the owner_submission marker. It can never go live
      // this way — an Owner still has to approve it in Listing Approvals.
      function isPublicOwnerSubmission() {
        return request.resource.data.source == "owner_submission"
          && request.resource.data.listingStatus == "pending";
      }
      allow create: if (isOwner()) || (isStaffOnly() && staffStatusOk()) || isPublicOwnerSubmission() || (request.auth != null && request.resource.data.listerId == request.auth.uid && request.resource.data.listingStatus != "offline");
      allow update: if (isOwner()) || (isStaffOnly() && staffStatusOk()) || (request.auth != null && resource.data.listerId == request.auth.uid && request.resource.data.listerId == request.auth.uid && listerListingStatusOk())
        // Public view-count increment (Property Details page, any visitor,
        // no auth) — restricted to ONLY the viewCount field changing so
        // this can't be abused to alter price/status/etc.
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        // STEP 2B.2 — Property Contact reply via private tracking link.
        // A visitor holding the unguessable trackToken of THIS submission may
        // write ONLY the three reply fields, and only when the token they
        // present matches the stored one and is left unchanged. Everything
        // else (price, status, contact, the Staff's original request) is
        // untouchable through this path. Enforced here, not in the UI.
        || (resource.data.source == "owner_submission"
            && resource.data.trackToken is string
            && resource.data.trackToken.size() > 20
            && request.resource.data.trackToken == resource.data.trackToken
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['infoResponseMessage', 'infoResponseAt', 'infoResponseStatus',
                           'customerLanguage', 'customerLanguageConfirmed', 'customerLanguageSource'])
            && request.resource.data.infoResponseMessage is string
            && request.resource.data.infoResponseMessage.size() > 0
            && request.resource.data.infoResponseMessage.size() < 4000)

        // STEP 2B.2 — Language lock (separate branch on purpose).
        // Detecting the customer's real language happens on their FIRST chat
        // message, which is not an infoResponse reply, so that branch above
        // (which demands infoResponseMessage) can never authorise it. This
        // branch lets the same token holder write ONLY the three language
        // fields — nothing else, token still unchanged, value still from the
        // supported list, and the flag can only ever be set to true.
        || (resource.data.source == "owner_submission"
            && resource.data.trackToken is string
            && resource.data.trackToken.size() > 20
            && request.resource.data.trackToken == resource.data.trackToken
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['customerLanguage', 'customerLanguageConfirmed', 'customerLanguageSource'])
            && request.resource.data.customerLanguage in ['th','en','zh','ru','de','no','fr','it']
            && request.resource.data.customerLanguageConfirmed == true
            && request.resource.data.customerLanguageSource == 'message_detected')

        // CASE MESSENGER PHASE 1 — read markers and last-message stamps.
        // Unread state must NOT be stored on the messages (caseMessages is
        // append-only), so it lives here as timestamps. The token holder may
        // set only the customer-side markers; Staff/Owner set the staff side
        // through the isAdmin() branch above. No content field is reachable.
        || (resource.data.source == "owner_submission"
            && resource.data.trackToken is string
            && resource.data.trackToken.size() > 20
            && request.resource.data.trackToken == resource.data.trackToken
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['customerLastReadAt', 'lastCustomerMessageAt']))

        // PHASE 1A.2 (ก.ย. 2569) — photo-upload follow-up markers.
        // Owner Submission no longer aborts the whole submission when one
        // photo upload fails; it records the failure on the case so Staff can
        // chase the missing photos. That note is written by a signed-out
        // visitor immediately after their own create, so it needs its own
        // narrow branch. Three harmless boolean/count/string fields only —
        // no price, status, contact or workflow field is reachable here.
        || (resource.data.source == "owner_submission"
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['photoUploadFailedCount', 'photoUploadFollowUpNeeded', 'photoUploadLastError'])
            && request.resource.data.photoUploadFollowUpNeeded == true);
      allow delete: if isOwner() || (request.auth != null && resource.data.listerId == request.auth.uid);

      // STEP 2B.2 — Case conversation for owner-submission cases.
      // Append-only history. The customer has no account: their private
      // trackToken (stored on the parent property doc) is what authorises
      // them, and it must be presented on every message they write. They can
      // only ever ADD a customer-visible inbound message — never read an
      // internal note, never edit or delete anything, never touch the parent
      // property. Staff/Owner use the existing isAdmin() role.
      // INTAKE WORKFLOW (Aug 2026) — internal review history.
      // Team-only in BOTH directions: the customer's tracking token grants no
      // access here at all, so review reasons, reviewer names and internal
      // workflow state stay internal. Submissions are never deleted, so the
      // "#1 returned, #2 approved" history cannot be rewritten.
      // canReviewIntake / canApproveIntake — expressed here as isOwner().
      // To authorise a future Supervisor/Reviewer role, widen isOwner() (or
      // add a capability helper beside it) in ONE place; nothing in the
      // workflow references a specific account.
      match /submissions/{subId} {
        allow read: if isAdmin();
        // Staff submit their own work…
        allow create: if isAdmin();
        // …but ONLY an authorized reviewer records the verdict. This is the
        // database-level half of separation of duties: the submitter cannot
        // approve their own case even by calling the client helper directly.
        allow update: if isOwner();
        allow delete: if false;
      }
      match /caseMessages/{msgId} {
        function parent() {
          return get(/databases/$(database)/documents/properties/$(id)).data;
        }
        function tokenOk(t) {
          return parent().source == "owner_submission"
            && parent().trackToken is string
            && parent().trackToken.size() > 20
            && t == parent().trackToken;
        }
        // Reads: team sees everything; a token-holder sees only messages
        // marked visible to the customer. Client queries MUST filter on
        // visibility == "customer" for a customer-side list to succeed.
        allow read: if isAdmin()
          || (resource.data.visibility == "customer" && resource.data.caseToken is string && tokenOk(resource.data.caseToken));
        allow create: if isAdmin()
          || (request.resource.data.senderType == "customer"
              && request.resource.data.direction == "inbound"
              && request.resource.data.visibility == "customer"
              && request.resource.data.caseToken is string
              && tokenOk(request.resource.data.caseToken)
              && request.resource.data.originalText is string
              && request.resource.data.originalText.size() > 0
              && request.resource.data.originalText.size() < 4000);
        // History is immutable — no edits, no deletes, by anyone.
        allow update, delete: if false;
      }
    }
    // Public reporting channel (Aug 2026): anyone, signed in or not, can
    // flag a listing for admin review — create-only, no read/update/delete,
    // so a reporter can never see or tamper with other people's reports.
    // Admin (Listing Approvals.dc.html "รายงานปัญหา" tab) reads/resolves.
    // Transport-agnostic notification queue for the intake workflow.
    // Team-only in both directions — a customer tracking token grants nothing
    // here, so review reasons and reviewer identities never leak. A LINE /
    // email adapter will consume these server-side later; nothing here is
    // public, and a missing transport can never block a submission because
    // creating the event is all the workflow ever does.
    // Public listing code → internal case reference. Team-only: the public
    // site never needs this lookup, and exposing it would leak the internal
    // reference for every listing.
    match /propertyCodeMap/{code} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /notificationEvents/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }
    match /propertyReports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.propertyId is string && request.resource.data.propertyId.size() > 0;
    }
    // Public read. Admin can write anything. A signed-in lister may write a
    // photo doc for a property they own (checked via the linked property's
    // listerId) — needed for self-serve photo upload in Lister Dashboard.
    match /propertyPhotos/{id} {
      allow read: if true;
      // create/update carry the new doc as request.resource; a delete has
      // no request.resource at all (there's no incoming data), so the old
      // single "allow write" rule read request.resource.data.propertyId on
      // EVERY operation including delete — that threw and silently denied
      // every non-admin photo delete, which is exactly what made this rule
      // impossible to test as a plain lister (found auditing Admin
      // Dashboard's delete-cleanup fix). Delete must check resource (the
      // doc being removed) instead.
      // Public owner-submission photos: a visitor with no account may attach
      // photos to a property that is itself an unpublished pending
      // owner_submission (see the properties rule above). Nothing else.
      function isPhotoForPublicSubmission() {
        return exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId))
          && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.source == "owner_submission"
          && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.listingStatus == "pending";
      }
      // A create always carries a propertyId; that alone is enough for the
      // public owner-submission flow (photos are useless without the parent
      // listing, which itself can only be created as an unpublished pending
      // submission). Simpler and more reliable than a cross-document get(),
      // which failed for real visitors.
      allow create: if request.resource.data.propertyId is string && request.resource.data.propertyId.size() > 0;
      allow update: if isAdmin() || isPhotoForPublicSubmission() || (request.auth != null &&
        exists(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)) &&
        get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.listerId == request.auth.uid);
      allow delete: if isAdmin() || (request.auth != null &&
        exists(/databases/$(database)/documents/properties/$(resource.data.propertyId)) &&
        get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.listerId == request.auth.uid);
    }
    // CEO Project Dashboard doc is internal-only (risks/decisions not meant
    // for public eyes) — carved out of the otherwise-public siteContent
    // rule below. Firestore evaluates ALL matching rules and allows the
    // request if ANY grants it, so the general rule must explicitly
    // exclude this id or it would still be publicly readable.
    match /siteContent/projectDashboard { allow read, write: if isAdmin(); }
    // Pre-migration safety backup of the dashboard doc — same sensitivity
    // as projectDashboard itself (risks/decisions), so it gets the same
    // admin-only lockdown instead of falling through to the public rule.
    match /siteContent/projectDashboard_backup_v1 { allow read, write: if isAdmin(); }
    match /siteContent/{id} { allow read: if id != "projectDashboard" && id != "projectDashboard_backup_v1"; allow write: if isOwner() && id != "projectDashboard" && id != "projectDashboard_backup_v1"; }
    match /profilePhotos/{id} { allow read: if true; allow write: if isAdmin() || request.auth != null; }
    match /aiNotes/{id} { allow read: if true; allow write: if isOwner(); }
    match /banners/{id} {
      allow read: if true;
      // Public self-serve (Advertise.dc.html): anyone can create their OWN
      // pending banner doc (unpaid, active:false) — the Stripe webhook is
      // the only thing that ever flips it to active:true. Admin can create
      // (and activate) its own banners directly (e.g. house-inventory
      // banners added in Site Content) regardless of the active value.
      allow create: if isAdmin() || request.resource.data.active == false;
      allow update, delete: if isAdmin();
    }
    match /externalServices/{id} { allow read, write: if isOwner(); }

    // Buyer Registration (BLUEPRINT.md §2 ทาง 4 — "Procuring Cause" dispute
    // prevention for VIP agents). A signed-in lister can create a
    // registration under their own listerId, and read/list registrations
    // (needed client-side to detect a duplicate buyer before creating one —
    // the actual buyer contact details are only meant to be seen by admin
    // and the registering agent themselves in the UI layer, but Firestore
    // rules alone can't hide fields within a doc, so treat this collection
    // as agent-visible, not fully private).
    match /buyerRegistrations/{id} {
      allow read: if request.auth != null || isAdmin();
      allow create: if request.auth != null && request.resource.data.listerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Team management — Owner-only. Staff invites are keyed by lowercase
    // email until the invited person signs up (then moved to adminUsers/{uid}).
    match /adminUsers/{uid} {
      allow read: if isAdmin();
      allow write: if isOwner();
      // Allow a newly-signed-up staff member to create ONLY their own doc,
      // ONLY as role "staff", ONLY if an owner-issued invite for their email
      // still exists — closes the loop of Staff Signup without needing an
      // Owner to be online to click anything at that moment.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == "staff"
        && exists(/databases/$(database)/documents/staffInvites/$(request.auth.token.email));
    }
    match /staffInvites/{email} {
      allow get: if true;
      allow list: if isOwner();
      allow write: if isOwner();
    }

    // Leads captured from the public contact form / auto-bot engagement —
    // anyone can create one (that's the point of a lead form), but only the
    // admin can read/list them (contains a visitor's personal contact info).
    // STEP 2A-Security (ส.ค. 2569): Need-to-Know — reading/editing leads was
    // made OWNER-only, on the reasoning that a Staff member working the
    // owner-submission queue had no reason to read the whole buyer database.
    //
    // C0.5 (ก.ย. 2569) — Product Owner reversed that scope decision: the Lead
    // Inbox (Leads.dc.html) is the ONE place incoming customer enquiries are
    // worked, and Owner-only access meant a Contact submission sat unseen
    // unless the Owner personally opened the page. Authorized internal team
    // members (adminUsers — i.e. isAdmin(), which covers Staff and Owner) may
    // now read and update leads so they can actually action them.
    //
    // Deliberately NOT broadened:
    //   create → still `if true` (that IS the public contact form; anonymous
    //            visitors must be able to submit and nothing more)
    //   delete → still isOwner() (destroying customer records stays with the
    //            Owner; Staff can work a lead but never erase it)
    // Enforced here at the rules level, not just hidden in the UI, so it
    // cannot be bypassed from devtools/console.
    match /leads/{id} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if isOwner();
    }

    // Team activity log (Aug 2026): written automatically by the app whenever
    // an Owner/Staff member performs a tracked action. Append-only by design —
    // nobody (not even the Owner) may edit or delete an entry, so the record
    // stays trustworthy as a performance history. Team-readable only.
    match /activityLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Monthly targets — Owner sets them, Staff can read to see their progress.
    match /monthlyTargets/{key} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // Payments ledger (BLUEPRINT.md §4) — written ONLY by the stripeWebhook
    // Cloud Function via the Admin SDK, which bypasses these rules entirely.
    // No client (not even the lister themselves) can create/edit a payment
    // record directly — that would let someone fake a "paid" entry.
    match /payments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Self-serve accounts (Agent/owner) — Admin can see/approve, the account
    // owner can see/edit only their own status, and the public can read
    // (needed for the public Agent Profile page — anyone visiting a
    // lister's shared personal site must be able to look up their name/
    // photo/contact info without being signed in).
    match /listers/{uid} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Owner/tenant contact records — not meant for public browsing, but the
    // site currently reads them client-side (Owners directory, property
    // owner lookups) without a public-facing display of sensitive fields.
    // Kept admin-write / open-read for now; revisit if a public page ever
    // needs to filter/display owner data directly.
    match /owners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /tenants/{id} { allow read: if true; allow write: if isAdmin(); }

    // Admin credentials doc (legacy fallback login) and site settings —
    // never publicly readable; the values include a legacy plaintext
    // password fallback.
    match /settings/{id} { allow read, write: if isAdmin(); }

    // Per-lister chat leads captured on their own Agent Profile page (scoped
    // AI chat widget) — anyone can create one (that's the point), only the
    // owning lister or admin can read them back.
    match /listerLeads/{id} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.listerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Conversation Ownership (Firestore Realtime chat) — every
    // conversation belongs to a real owner (resolved server-side from a
    // real member/admin account, never a client-editable URL string).
    // Customers are Firebase Anonymous Auth users; visitorId is ALWAYS
    // request.auth.uid, never a client-supplied string. Conversation docs
    // and AI-role messages are created ONLY by the startConversation /
    // sendConversationTurn Callable Functions (Admin SDK bypasses these
    // rules entirely) — no rule below ever grants a client permission to
    // create a conversation directly or write role == "ai".
    match /conversations/{conversationId} {
      function isVisitor() {
        return request.auth != null && request.auth.uid == resource.data.visitorId;
      }
      function isConvOwner() {
        return isAdmin() || (request.auth != null && request.auth.uid == resource.data.ownerId);
      }
      // Firestore evaluates a `list` query per-candidate-document against
      // this SAME `read` rule (get + list share `allow read`) — a query
      // that isn't scoped by ownerId/visitorId simply returns zero
      // documents. The client must always query
      // `where("ownerId","==",myUid)` (or visitorId) for this to return
      // anything at all.
      allow read: if isAdmin() || isVisitor() || isConvOwner();
      allow create: if false;
      // Visitor may only ever touch updatedAt (a read-receipt timestamp).
      // Owner may update ownerNote/status/visitorLabel/unreadByOwner but
      // never the identity fields that establish who this belongs to.
      allow update: if isAdmin() || (
        isVisitor() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["updatedAt", "lastMessage", "lastMessageRole", "lastMessageAt", "unreadByOwner"]) &&
        request.resource.data.visitorId == resource.data.visitorId &&
        request.resource.data.ownerId == resource.data.ownerId
      ) || (
        isConvOwner() &&
        request.resource.data.visitorId == resource.data.visitorId &&
        request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if false;

      match /messages/{messageId} {
        function convData() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function isConvVisitor() {
          return request.auth != null && request.auth.uid == convData().visitorId;
        }
        function isConvOwnerOrAdmin() {
          return isAdmin() || (request.auth != null && request.auth.uid == convData().ownerId);
        }
        allow read: if isAdmin() || isConvVisitor() || isConvOwnerOrAdmin();
        // Direct client writes are allowed ONLY for role "customer" (by
        // the conversation's own visitor) or role "owner" (by the owner).
        // "ai" role can never be written by a client — only the
        // sendConversationTurn Cloud Function (Admin SDK) writes it.
        allow create: if (
          request.resource.data.role == "customer" &&
          isConvVisitor() &&
          request.resource.data.senderId == request.auth.uid
        ) || (
          request.resource.data.role == "owner" &&
          isConvOwnerOrAdmin()
        );
        allow update, delete: if false;
      }
    }

    // Default deny for anything not explicitly listed above.
    match /{document=**} { allow read, write: if false; }
  }
}
